
# ==================================================
# CM Kerala Grievance Portal - Backend Configuration
# ==================================================


# Database - Neon PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRE_MINUTES=720

# Allowed Frontend Origins
CORS_ORIGINS=http://localhost:5173,https://cm-kerala-grievance-portal-orcin.vercel.app

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Fictional Demo Account Passwords
DEMO_ADMIN_PASSWORD=REPLACE_WITH_DEMO_ADMIN_PASSWORD
DEMO_OFFICER_PASSWORD=REPLACE_WITH_DEMO_OFFICER_PASSWORD
DEMO_CITIZEN_PASSWORD=REPLACE_WITH_DEMO_CITIZEN_PASSWORD
